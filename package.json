{
  "name": "cooking-pi",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible Pi workbench: recipes, configuration, extensions, and the reasons behind them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M1racleShih/cooking-pi.git"
  },
  "homepage": "https://github.com/M1racleShih/cooking-pi#readme",
  "bugs": "https://github.com/M1racleShih/cooking-pi/issues",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.8.0",
  "bin": {
    "cooking-pi": "bin/cooking-pi.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "configuration",
    "dotfiles"
  ],
  "pi": {
    "extensions": [
      "./extensions/clear.ts"
    ],
    "themes": [
      "./themes/catppuccin-latte.json",
      "./themes/catppuccin-frappe.json"
    ]
  },
  "scripts": {
    "plan": "node bin/cooking-pi.mjs plan",
    "setup": "node bin/cooking-pi.mjs setup",
    "pi": "node bin/cooking-pi.mjs run",
    "doctor": "node bin/cooking-pi.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "test:load": "node scripts/verify-load.mjs",
    "test:tui": "python3 scripts/verify-tui.py",
    "check:public": "node scripts/check-public.mjs",
    "verify": "npm test && npm run check:public && npm run test:load"
  },
  "dependencies": {
    "@ff-labs/pi-fff": "0.11.0",
    "@juicesharp/rpiv-ask-user-question": "2.13.8",
    "@juicesharp/rpiv-todo": "2.13.8",
    "@narumitw/pi-goal": "0.54.11",
    "pi-cc-extensions": "1.0.4",
    "pi-codex-compaction": "0.2.3",
    "pi-session-titler": "0.1.0",
    "pi-undo-redo": "0.1.4",
    "pi-web-access": "0.39.0",
    "pi-provider-model-picker": "https://codeload.github.com/M1racleShih/pi-provider-model-picker/tar.gz/94e218dd6a14cf43fab0e4fde0e9c9908412cb16",
    "pi-block-editor": "https://codeload.github.com/M1racleShih/pi-block-editor/tar.gz/bb42e1ff1f55db0c1bf080fe5631a16ca10648c5",
    "@cooking-pi/hud-snapshot": "file:packages/pi-hud-snapshot"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0"
  }
}
